@import '../../sub_utils/font-face.wxss';

page {
  position: relative;
  padding-bottom: 300rpx;
}

text {
  font-family: Inter Tight;
}

.word-list {
  width: 92vw;
  max-width: 1160px;
  margin: 3.5vh auto 0 auto;
  padding: 4rpx 1vw;
  box-sizing: border-box;
  border: 1px solid #ddd;
  background-color: rgba(232, 232, 216, 0.1);
  box-shadow: 0 0 30rpx rgba(0, 0, 0, 0.1);
}

.word-item {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 112rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.05);
  background-color: rgba(232, 232, 216, 0.1);
  overflow: hidden;
  border-radius: 8rpx;
  transition: transform 0.3s ease-in-out;
}

/* 内容部分 */
.word-content {
  display: flex;
  flex-direction: column;
  padding: 10rpx 16rpx;
  flex: 1;
  box-sizing: border-box;
}

/* 英文单词样式 */
.english-words {
  font-size: 18px;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* 中文释义样式 */
.chinese-meaning {
  font-size: 16px;
  color: #555;
  text-align: center;
}

/* 删除按钮样式 */
.delete-button {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 150rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #d9534f; /* 红色按钮 */
  color: white;
  font-size: 16px;
  box-shadow: -2rpx 0 10rpx rgba(0, 0, 0, 0.1);
  transform: translateX(100%);
  transition: transform 0.3s ease-in-out;
}

/* 滑动显示删除按钮 */
.word-item.active {
  transform: translateX(-150rpx);
}

.word-item.active .delete-button {
  transform: translateX(0);
}